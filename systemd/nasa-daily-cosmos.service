[Unit]
Description=NASA Astronomy Picture of the Day
After=graphical-session.target
# Give up after 5 tries (~10 min) so a lasting failure doesn't retry all day; the timer tries again tomorrow.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/nasa-daily-cosmos.env
ExecStart=%h/.local/bin/nasa-daily-cosmos
# A browser opened by "Details" runs in this unit; don't kill it when the script exits.
KillMode=process
# Retry when the network isn't up yet right after login.
Restart=on-failure
RestartSec=2min
